# Mau bien moi truong cho API (Docker / server). Sao chep thanh .env va dien gia tri that.
# KHONG commit file .env.

ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080

ConnectionStrings__Default=Server=sqlserver,1433;Database=NguyenBinhOfficial;User Id=nb_app;Password=CHANGE_ME;TrustServerCertificate=True;Encrypt=True;Connect Timeout=30

# Chuoi ngau nhien >= 32 ky tu (vd: openssl rand -base64 48)
Jwt__Secret=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# Chi dung lan khoi dong dau tien de tao SuperAdmin; xoa sau khi da dang nhap va doi mat khau.
Seed__AdminEmail=admin@nguyenbinhofficial.com.vn
Seed__AdminPassword=CHANGE_ME

Redis__ConnectionString=redis:6379

Cors__AllowedOrigins__0=https://nguyenbinhofficial.com.vn

Storage__RootPath=/app/storage
Storage__PublicBaseUrl=https://nguyenbinhofficial.com.vn

Database__MigrateOnStartup=false
ForwardedHeaders__TrustAllProxies=true
Swagger__Enabled=false
