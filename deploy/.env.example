# deploy/.env — bien moi truong cua container API. KHONG commit file .env.
# Tao: cp .env.example .env && chmod 600 .env && nano .env

# SQL Server tren host. Dung login rieng (db_owner chi tren database NguyenBinhOfficial), khong dung tai khoan admin SQL.
ConnectionStrings__Default=Server=host.docker.internal,1433;Database=NguyenBinhOfficial;User Id=nb_app;Password=CHANGE_ME;TrustServerCertificate=True;Encrypt=True;Connect Timeout=30

# Chuoi ngau nhien >= 32 ky tu: openssl rand -base64 48
Jwt__Secret=CHANGE_ME

# Chay migration khi khoi dong (1 instance). Dat false neu muon chay script migration thu cong.
Database__MigrateOnStartup=true

# Chi can lan dau neu database chua co SuperAdmin.
# Seed__AdminEmail=admin@nguyenbinhofficial.com.vn
# Seed__AdminPassword=CHANGE_ME

Cors__AllowedOrigins__0=https://nguyenbinhofficial.com.vn

# Anh luu tren ImageKit (CDN). Thu muc goc tren ImageKit: nguyenbinhofficial/...
Storage__Provider=ImageKit
ImageKit__UrlEndpoint=https://ik.imagekit.io/hflybceh5
ImageKit__PublicKey=CHANGE_ME
ImageKit__PrivateKey=CHANGE_ME
Media__KeyPrefix=nguyenbinhofficial

Swagger__Enabled=false
