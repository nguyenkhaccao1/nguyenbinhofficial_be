{
  "ConnectionStrings": {
    "Default": ""
  },
  "Database": {
    "MigrateOnStartup": false,
    "SeedOnStartup": true
  },
  "Seed": {
    "AdminEmail": "",
    "AdminPassword": ""
  },
  "Jwt": {
    "Issuer": "nguyenbinh-official",
    "Audience": "nguyenbinh-admin",
    "Secret": ""
  },
  "Auth": {
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7,
    "PersistentRefreshTokenDays": 30,
    "RefreshCookie": {
      "Name": "nb_rt",
      "Path": "/api/v1/admin/auth",
      "Secure": true
    }
  },
  "Cors": {
    "AllowedOrigins": [ "https://nguyenbinhofficial.com.vn" ]
  },
  "ForwardedHeaders": {
    "TrustAllProxies": false
  },
  "Redis": {
    "ConnectionString": ""
  },
  "Storage": {
    "RootPath": "storage",
    "PublicBaseUrl": "",
    "PublicRequestPath": "/media"
  },
  "Swagger": {
    "Enabled": false
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http": "Warning"
      }
    },
    "SqlSink": {
      "Enabled": true
    }
  },
  "AllowedHosts": "*"
}
